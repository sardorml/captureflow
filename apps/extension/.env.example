# Origin of the CaptureFlow web app (sign-in + recording API). Optional: dev builds
# already default to http://localhost:3032 and production builds to prod. Set
# this only to override (e.g. a staging origin or a different local port).
WXT_WEB_BASE=https://captureflow.dev

# The Web Store item's public key. Chrome derives the extension id from it, so
# setting it makes an unpacked build load under the store id rather than a
# per-machine one — which is what the web app's CAPTUREFLOW_EXTENSION_ID pins
# against. Without it, /auth/callback refuses the handoff on production.
# Find it under Build -> Package -> Public Key in the developer dashboard, then
# drop the BEGIN/END lines and join the body onto one line.
# `pnpm zip` ignores this, so an uploaded package never carries a key.
WXT_EXT_KEY=
