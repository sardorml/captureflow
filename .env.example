# CaptureFlow self-hosted (Docker). Copy to .env and edit.
# Everything not set here is optional.

# Public URLs people will open. Screen recording needs a secure context, so
# use https:// behind a reverse proxy anywhere other than localhost.
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Host ports (docker-compose only).
# WEB_PORT=3000
# ADMIN_PORT=3001

# Outgoing mail (workspace invites, access requests, welcome notes). Without
# it, messages are printed to `docker compose logs web` instead.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=CaptureFlow <recordings@example.com>

# Transcripts: any OpenAI-compatible /v1/audio/transcriptions server.
# With `docker compose --profile whisper up -d`:
# WHISPER_API_URL=http://whisper:8000
# WHISPER_MODEL=Systran/faster-whisper-small
# Or a hosted one:
# WHISPER_API_URL=https://api.openai.com
# WHISPER_API_KEY=sk-...
# WHISPER_MODEL=whisper-1

# Only let addresses on these domains sign up (comma-separated).
# ALLOWED_EMAIL_DOMAINS=example.com

# Optional OAuth sign-in. Callback: <APP_URL>/api/auth/callback/<google|github>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# The ID of the Chrome extension you built against APP_URL, so it can sign in.
# CAPTUREFLOW_EXTENSION_ID=

# Generated on first start and kept in ./data/secrets.json unless set here.
# BETTER_AUTH_SECRET=
# ADMIN_SESSION_SECRET=
# ADMIN_SETUP_TOKEN=
